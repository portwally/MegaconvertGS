LOAD AS c1 *:MCTEST:S320.C1
TIFFOPT 0 0 1 Hello IIgs
SAVE AS tiff *:MCOUT:TIFP
TIFFOPT 0 1 2 
SAVE AS tiff *:MCOUT:TIFPM
LOAD AS c1 *:MCTEST:S640.C1
TIFFOPT 0 1 1 
SAVE AS tiff *:MCOUT:TIF640
LOAD AS png *:MCTRUE:RGB8.PNG
SAVE C1 *:MCOUT:TIFBSCR
TIFFOPT 2 1 1 Both
SAVE AS tiff *:MCOUT:TIFB
TIFFOPT 1 0 1 
SAVE AS tiff *:MCOUT:TIFR
SHOW
